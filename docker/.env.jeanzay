###
# Jean Zay H100 overrides
###
ISAACLAB_BASE_IMAGE=isaac-lab-base:2.1.1-rebuilt
ISAACLAB_EXTENSION_TEMPLATE_PATH=/workspace/tacex
DOCKER_ISAACLAB_PATH=/workspace/isaaclab
# H100 = sm_90 (Hopper), keep 8.9 for local compatibility via PTX
CMAKE_CUDA_ARCHITECTURES=90a
TORCH_CUDA_ARCH_LIST="9.0a+PTX"